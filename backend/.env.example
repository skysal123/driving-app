# Local development. Docker Compose uses the root .env.example instead.

SECRET_KEY=dev-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me
JWT_TTL_DAYS=30

# Leave DATABASE_URL unset to use SQLite at backend/instance/drivedesk.db.
# DATABASE_URL=postgresql://drivedesk:drivedesk@localhost:5432/drivedesk

# Defaults: backend/instance/uploads and ../prototype
# UPLOAD_FOLDER=
# FRONTEND_FOLDER=

SUBSCRIPTION_PRICE=199
SUBSCRIPTION_GRACE_HOURS=48
SUBSCRIPTION_UPI_ID=drivedesk@upi
DEFAULT_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=*
ADMIN_EMAIL=admin@drivedesk.in
ADMIN_PASSWORD=changeme123
ADMIN_NAME=DriveDesk Admin
SESSION_COOKIE_SECURE=false
