# Copy to .env for Docker Compose and replace every secret.
DOMAIN=drivedesk.example.com

# SQLite (current default). The app container keeps its database in the
# "sqlite" named volume at /app/backend/instance/drivedesk.db.
# No DATABASE_URL needed with SQLite.

# PostgreSQL (commented). Restore the db service + DATABASE_URL + pgdata
# volume sections in docker-compose.yml to switch back.
# POSTGRES_DB=drivedesk
# POSTGRES_USER=drivedesk
# POSTGRES_PASSWORD=replace-with-a-long-database-password

SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-another-long-random-secret
JWT_TTL_DAYS=30

ADMIN_EMAIL=admin@yourdomain.in
ADMIN_PASSWORD=replace-with-a-strong-admin-password
ADMIN_NAME=DriveDesk Admin

SUBSCRIPTION_PRICE=199
SUBSCRIPTION_GRACE_HOURS=48
SUBSCRIPTION_UPI_ID=drivedesk@upi
DEFAULT_TIMEZONE=Asia/Kolkata
CORS_ORIGINS=*
SESSION_COOKIE_SECURE=true
